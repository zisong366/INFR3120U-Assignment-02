
<%- include('partials/header', { title: 'About Me' }) %>

<section class="container py-5">

  <!-- About Me Heading -->
  <h1 class="text-center mb-5">About Me</h1>

  <div class="row align-items-center g-5">

    <!-- Profile Picture -->
    <div class="col-md-4 text-center">
      <img
        src="/images/196.jpg"
        alt="Zisong's Profile Picture"
        class="img-fluid rounded-circle shadow"
        style="width: 250px; height: 250px; object-fit: cover;"
      >
    </div>

    <!-- Personal Introduction -->
    <div class="col-md-8">
      <h2>Hello! I'm Zisong.</h2>

      <p class="lead">
        I am a student interested in technology,
        programming, and web development.
        I enjoy learning new skills and building
        projects that help me improve my knowledge.
      </p>

      <p>
        Through my coursework, I have gained
        experience with HTML, CSS, JavaScript,
        Node.js, and ExpressJS.
      </p>

      <h3 class="mt-4">My Skills</h3>

      <ul>
        <li>HTML and CSS</li>
        <li>JavaScript</li>
        <li>Node.js and ExpressJS</li>
        <li>Git and GitHub</li>
        <li>Responsive Web Design</li>
      </ul>

      <a href="/projects" class="btn btn-primary mt-3">
        View My Projects
      </a>
    </div>

  </div>

  <!-- Introduction Video -->
  <div class="row justify-content-center mt-5">
    <div class="col-md-9 text-center">

      <hr class="my-5">

      <h2 class="mb-3">My Introduction Video</h2>

      <p class="lead mb-4">
        Watch my introduction video to learn
        more about me and my interests!
      </p>

      <video
        controls
        preload="metadata"
        class="w-100 rounded shadow"
        style="max-width: 750px;"
      >
        <source
          src="/videos/introduction.mp4"
          type="video/mp4"
        >
        Your browser does not support HTML5 video.
      </video>

    </div>
  </div>

</section>

<%- include('partials/footer') %>
