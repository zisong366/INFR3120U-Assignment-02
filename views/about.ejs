<%- include('partials/header') %>

<section class="container py-5 text-center">

  <h1 class="mb-4">About Me</h1>

  <img
    src="/images/profile.jpg.avif"
    alt="My Profile Picture"
    class="rounded-circle mb-4"
    style="width: 200px; height: 200px; object-fit: cover;"
  >

  <h2>Hello! I'm Zisong Zhou</h2>

  <p class="lead mt-3">
    I am a student passionate about technology,
    web development, and learning new skills.
    I enjoy exploring programming and building
    creative web applications.
  </p>

  <hr class="my-5">

  <h2 class="mb-3">My Introduction Video</h2>

  <p>
    Watch my introduction video to learn more
    about me and my interests.
  </p>

  <div class="row justify-content-center">
    <div class="col-md-8">

      <video
        controls
        preload="metadata"
        class="w-100 rounded shadow"
      >
        <source
          src="/videos/introduction.mp4"
          type="video/mp4"
        >
        Your browser does not support video playback.
      </video>

    </div>
  </div>

  <a href="/" class="btn btn-primary mt-4">
    Back to Home
  </a>

</section>

<%- include('partials/footer') %>
